# Port the web UI + API are served on
PORT=4000

# Used to encrypt saved connection passwords at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-this-with-a-long-random-string

# Where the SQLite file (connections + history) is stored
DB_FILE=./data/BenhSQL.sqlite

# Max rows returned to the browser per query, to protect against accidentally
# fetching huge result sets into memory
MAX_ROWS=1000
